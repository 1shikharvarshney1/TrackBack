# TrackBack Environment Configuration

# -----------------------------------------------------------------------------
# Server Network Configuration
# -----------------------------------------------------------------------------
# Port for the Express backend server (default: 5000)
PORT=5000

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------
# MongoDB connection URI (local instance or MongoDB Atlas cluster)
# Format: mongodb://localhost:27017/trackback or mongodb+srv://<user>:<password>@cluster.mongodb.net/trackback
MONGO_URI=mongodb://127.0.0.1:27017/trackback

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (JWT).
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# -----------------------------------------------------------------------------
# Computer Vision & Telemetry Calibration
# -----------------------------------------------------------------------------
# Linear calibration factor to approximate speed (km/h) from 2D pixel displacement
# speed = (pixel_displacement / fps) * SPEED_CALIBRATION
SPEED_CALIBRATION=0.5

# -----------------------------------------------------------------------------
# Vision AI / Optical Character Recognition (OCR)
# -----------------------------------------------------------------------------
# Google Gemini API Key for license plate recognition on cropped vehicle bumpers.
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (e.g., gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Maximum number of external OCR calls allowed per video clip (prevents quota exhaustion)
MAX_GEMINI_CALLS_PER_VIDEO=10
